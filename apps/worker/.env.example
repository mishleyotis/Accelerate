# svc_worker — example environment (Implementation Plan S.2)
# Real values live in Secret Manager, mounted as env at deploy.

# --- Database ---
DB_INSTANCE_CONNECTION_NAME=digital-maturity-assessor:us-central1:<instance>
DB_USER=svc_worker
DB_NAME=dma_insights
DB_USE_IAM_AUTH=true

# --- Cache (ingest job queue, claim leases with TTL) ---
REDIS_URL=redis://<memorystore-host>:6379/0

# --- Drive intake (read-only delegation on the assessment tree) ---
DRIVE_INTAKE_FOLDER_ID=<intake-folder-id>

# --- Artefact store (worker holds the only writer role) ---
GCS_ARTEFACT_BUCKET=<artefact-bucket>
GCS_EXPORT_BUCKET=<export-bucket>
GCS_CORPUS_PACK_BUCKET=<corpus-pack-bucket>
# Local only: ARTEFACT_STORE_PATH=.local-artefacts

ENV=local
LOG_LEVEL=info
