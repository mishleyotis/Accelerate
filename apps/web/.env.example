# web — example environment (Implementation Plan S.2)
# Real values live in Secret Manager, mounted as env at deploy.
# The frontend performs no inference and holds no model configuration.

API_BASE_URL=https://<api-cloud-run-url>
# Google OIDC (NextAuth), Workspace domain restricted
OIDC_CLIENT_ID=<oauth-client-id>
OIDC_CLIENT_SECRET=<secret-manager:oidc-client-secret>
NEXTAUTH_SECRET=<secret-manager:web-nextauth-secret>
NEXTAUTH_URL=https://<web-cloud-run-url>

ENV=local
