# svc_mcp — example environment (Implementation Plan S.2)
# Real values live in Secret Manager, mounted as env at deploy.
# The embedding model is bundled in-image (local CPU inference at submit
# only); it needs no endpoint, no key, and no configuration here.

# --- Database (session-mode pooling — the promote transaction holds locks) ---
DB_INSTANCE_CONNECTION_NAME=digital-maturity-assessor:us-central1:<instance>
DB_USER=svc_mcp
DB_NAME=dma_insights
DB_USE_IAM_AUTH=true

# --- Cache (claim leases) ---
REDIS_URL=redis://<memorystore-host>:6379/0

# --- Artefact store (excerpt verification reads bytes) ---
GCS_ARTEFACT_BUCKET=<artefact-bucket>
# Local only: ARTEFACT_STORE_PATH=.local-artefacts

# --- Connector credential (the only credential that can write serving tables) ---
MCP_BEARER_TOKEN=<secret-manager:mcp-bearer-token>

ENV=local
LOG_LEVEL=info
