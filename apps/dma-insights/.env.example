# DMA Insights — local development env vars
# Copy to .env (gitignored) and fill in. Secrets live in Google Secret Manager
# in prod; see comments below for the corresponding secret name.

# -------- Postgres --------
DATABASE_URL=postgresql+asyncpg://dma_insights:dma_insights_local@localhost:5433/dma_insights
# `+psycopg` pins SQLAlchemy to the psycopg3 driver (the one we ship in the
# backend image). Bare `postgresql://` defaults to psycopg2 in SQLAlchemy 2.0
# which is NOT installed -> ModuleNotFoundError on every cold start. Fix landed
# 2026-05-24 (commit 7d30839) after Cloud Build alembic-against-backend-image
# failed with this exact error.
DATABASE_URL_SYNC=postgresql+psycopg://dma_insights:dma_insights_local@localhost:5433/dma_insights

# -------- Redis --------
REDIS_URL=redis://localhost:6380/0

# -------- App --------
ENV=local
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

# -------- Google OAuth (frontend client_id is public, safe to commit) --------
GOOGLE_OAUTH_CLIENT_ID=306195530103-ub6t46i8sd9q1eatpt6dgo0i9811mnrp.apps.googleusercontent.com
# Secret Manager: dma-insights-oauth-client-secret
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_HOSTED_DOMAIN=zennify.com

# -------- JWT --------
# Secret Manager: dma-insights-jwt-signing-key (RS256)
JWT_PRIVATE_KEY_PATH=./local-data/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./local-data/jwt-public.pem
JWT_ISSUER=https://dma-insights.local
JWT_AUDIENCE=dma-insights
JWT_TTL_HOURS=12

# -------- Vertex AI --------
VERTEX_PROJECT_ID=digital-maturity-assessor
VERTEX_LOCATION=us-central1
VERTEX_FLASH_MODEL=gemini-2.0-flash-001
VERTEX_PRO_MODEL=gemini-2.5-pro
VERTEX_EMBEDDING_MODEL=text-embedding-004

# -------- Offline NLP tiers (baked into the image; no operator action) --------
# The backend + worker images bake the spaCy en_core_web_sm model, the
# all-MiniLM-L6-v2 bi-encoder (recall) and the stsb-distilroberta cross-encoder
# (precision re-rank of evidence↔capability support). They load OFFLINE from
# baked dirs — these are set in the Dockerfiles' ENV and normally need no
# override. Shown here for visibility / local runs against a checkout:
#   DMA_ST_MODEL_DIR=/install/st-minilm     # bi-encoder dir (worker: /home/app/st-minilm)
#   DMA_CE_MODEL_DIR=/install/st-ce         # cross-encoder dir (worker: /home/app/st-ce)
#   HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 # never touch huggingface.co at run
# Escape hatches (leave UNSET in prod): DMA_DISABLE_SEMANTIC=1 forces the TF-IDF
# tier (no torch); DMA_DISABLE_RERANK=1 keeps the bi-encoder but skips the
# cross-encoder re-rank.
# Secret Manager: dma-insights-vertex-sa-key
GOOGLE_APPLICATION_CREDENTIALS=./local-data/vertex-sa.json

# -------- GCP project context (Pub/Sub publisher + Vertex fallback) --------
# 2026-05-28 audit fix: REQUIRED_FOR_PROD_BACKEND + REQUIRED_FOR_PROD_WORKER
# both require this. Terraform sets it from var.project_id at apply time;
# local dev / CI gets the literal default.
GCP_PROJECT_ID=digital-maturity-assessor

# -------- Clay enrichment connector (ADR 0010) --------
# 2026-05-28 audit fix: Clay is REQUIRED in prod per ADR 0010.
# Both secrets are loaded from Secret Manager:
#   dma-insights-clay-webhook-url    — outbound table-webhook URL
#   dma-insights-clay-webhook-secret — HMAC shared secret for /webhook callbacks
# Local dev can leave these empty; the connector returns ClayDisabled.
CLAY_WEBHOOK_URL=
CLAY_WEBHOOK_SECRET=

# -------- Google Drive + Sheets --------
DRIVE_ROOT_FOLDER_ID=1uvt3kh8vPIygFwUNfKQSol0m5OYj2O0P
OPS_SHEET_ID=1vQq4AMjtcS5eduDf_qIfXQYM7l0xYnVcmo-weqeXPs8

# -------- DMA Bot --------
DMA_BOT_URL=https://dma-bot-306195530103.us-central1.run.app
# Secret Manager: dma-insights-bot-api-key
DMA_BOT_API_KEY=

# -------- RAG API (Claude project consumer) --------
# Secret Manager: dma-insights-rag-api-key
RAG_API_BEARER_KEY=

# -------- Storage --------
GCS_BUCKET_REQUEST_MATERIALS=dma-insights-request-materials
GCS_BUCKET_CATALOGUE_STAGING=dma-insights-catalogue-staging
