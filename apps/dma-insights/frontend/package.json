{
  "name": "dma-insights-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "STANDALONE=1 vite build --outDir dist-standalone --mode standalone",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:standalone": "playwright test --config playwright.standalone.config.ts",
    "test:e2e:standalone:ui": "playwright test --config playwright.standalone.config.ts --ui",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:visual:ui": "playwright test --config playwright.visual.config.ts --ui",
    "test:visual:standalone": "playwright test --config playwright.visual.standalone.config.ts",
    "test:visual:standalone:update": "playwright test --config playwright.visual.standalone.config.ts --update-snapshots",
    "test:visual:standalone:ui": "playwright test --config playwright.visual.standalone.config.ts --ui",
    "verify:responsive-css": "node e2e/visual/verify-responsive-css.mjs",
    "compare:prototype": "node e2e/visual/side-by-side.mjs"
  },
  "dependencies": {
    "@react-oauth/google": "^0.12.1",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "eventsource-parser": "^3.0.0",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.2",
    "axe-core": "^4.11.4",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.2",
    "vitest-axe": "^0.1.0"
  }
}
