# svc_api — example environment (Implementation Plan S.2)
# Real values live in Secret Manager, mounted as env at deploy.
# There is deliberately no inference configuration: no model names, no
# inference endpoints, no temperature, no cache TTL for model output.
# With IAM database auth there is no database password at all.

# --- Database (Cloud SQL via Python Connector + automatic IAM auth in prod;
#     plain DSN only for local docker-compose parity) ---
DB_INSTANCE_CONNECTION_NAME=digital-maturity-assessor:us-central1:<instance>
DB_USER=svc_api
DB_NAME=dma_insights
DB_USE_IAM_AUTH=true
# Local only (docker-compose): LOCAL_DATABASE_URL=postgresql+asyncpg://svc_api@localhost:5432/dma_insights

# --- Cache ---
REDIS_URL=redis://<memorystore-host>:6379/0

# --- Auth (Google OIDC, Workspace domain restricted; role re-verified per request) ---
OIDC_CLIENT_ID=<oauth-client-id>
OIDC_CLIENT_SECRET=<secret-manager:oidc-client-secret>
OIDC_ALLOWED_DOMAIN=zennify.com
SESSION_COOKIE_SECRET=<secret-manager:api-session-secret>

# --- Serving ---
ENV=local
LOG_LEVEL=info
