{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "extraKnownMarketplaces": {
    "zennify-dma": {
      "source": {
        "source": "directory",
        "path": "/home/user/Accelerate"
      }
    }
  },
  "enabledPlugins": {
    "dma-insights@zennify-dma": true
  },
  "pluginConfigs": {
    "dma-insights@zennify-dma": {
      "options": {
        "repo_root": "/home/user/Accelerate",
        "mcp_base_url": "https://dmai-mcp-dukrne5v4a-uc.a.run.app"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(git push -u origin claude/:*)",
      "mcp__Clay",
      "mcp__Exa",
      "mcp__Tavily",
      "mcp__Vibe_Prospecting",
      "mcp__Indeed",
      "mcp__Quartr",
      "mcp__Google_Drive",
      "mcp__plugin_dma-insights_connector"
    ],
    "deny": [
      "WebFetch(domain:docs.google.com)",
      "Read(//root/.dma/sa.json)",
      "Read(//root/.dma/pathtok)"
    ]
  }
}
