# Secrets — never commit credentials of any kind
*.pem
*.key
*service-account*.json
*serviceaccount*.json
.env
.env.*
!.env.example
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
dist/
out/
*.tsbuildinfo

# Local artefact store (docker-compose filesystem GCS stand-in)
.local-artefacts/

# OS / editor
.DS_Store

# Atomic-write scratch from the editor tooling. These appear beside a file
# while it is being rewritten and vanish when the write lands — but a commit
# taken mid-edit would capture one, and a half-written module in the tree is
# worse than no commit at all.
*.tmp.*

# Client information never enters this repository. Assessment packages,
# workbooks, exported payloads and evidence extracts are client property and
# live in GCS and Drive, not in git. Fixtures use synthetic ids (E-XXX-nnn)
# and neutral display names.
fixtures/clients/
# Staged page payloads of a real run: verbatim rows, so they carry the
# r_layer records, internal_only blocks, named leadership and contact details
# the served projection strips. `scripts/fetch_staged_fixtures.py` puts them
# here on a machine that already holds connector credentials; the READMEs that
# say what belongs here stay tracked.
fixtures/staged_runs/*/*.json
*_Assessment_Workbook_*.xlsx
*_Research_Workbook_*.xlsx
**/startup-data/clients/
dma-insights-*.zip

# One session's own permission grants, not the project's. `settings.json`
# beside it IS tracked and carries what every session here should have;
# `settings.local.json` is the documented place for a personal override and
# is machine-local by convention. Committing one would push whichever MCP
# tools one operator happened to pre-approve into everybody else's sessions,
# which is a permission decision made in the wrong place and invisible to the
# person it lands on. The routine's headless approvals do not come from here
# either — they come from the plugin's own PreToolUse hook.
.claude/settings.local.json
