{
  "name": "dma-insights",
  "displayName": "DMA Insights",
  "version": "1.4.0",
  "description": "The six Digital Maturity Assessment skills, 64 DMA agents \u2014 including the 16 category-clustered researchers and their conductor \u2014 the remote DMA Insights MCP connector (33 tools), and the research ENGINE that makes a run finish unattended: the scoring workbook is the substrate every step writes to, and the four deliverables (workbook, Assessment Report, Client Research Profile, Technographic Scan) each have a producer and a reader. See docs/END-TO-END.md and scripts/aud_ledger.py.",
  "author": {
    "name": "Zennify \u2014 DMA Insights build"
  },
  "license": "UNLICENSED",
  "keywords": [
    "dma",
    "digital-maturity",
    "financial-services",
    "surface-production",
    "governance",
    "zennify"
  ],
  "defaultEnabled": false,
  "userConfig": {
    "mcp_base_url": {
      "type": "string",
      "title": "Connector base URL",
      "description": "Cloud Run URL of the deployed dmai-mcp service, no trailing slash. Override only for a staging deployment.",
      "default": "https://dmai-mcp-dukrne5v4a-uc.a.run.app",
      "required": true
    },
    "repo_root": {
      "type": "directory",
      "title": "DMA Insights repo checkout",
      "description": "Optional. Absolute path to a checkout of the DMA Insights repository. Only skills/dma-surface-production/scripts/precheck_gates.py uses it, to import the connector's own gate modules from apps/mcp rather than re-implementing them. Leave empty and precheck_gates.py reports which gates it could not run instead of guessing."
    }
  },
