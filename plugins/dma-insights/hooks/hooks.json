{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/deny_credential_ops.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dma-insights_connector__submit_page_payload",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/precheck_submit.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dma-insights_connector__promote_run",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/precheck_promote.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_dma-insights_connector__submit_page_payload",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/verdict_watch.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_dma-insights_connector__promote_run",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/verdict_watch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}