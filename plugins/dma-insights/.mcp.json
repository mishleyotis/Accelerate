{
  "mcpServers": {
    "connector": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/mcp_proxy.py",
        "${user_config.mcp_base_url}"
      ]
    },
    "evidence": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/evidence_proxy.py",
        "${user_config.evidence_base_url}",
        "--secret",
        "dmai-evidence-path-token"
      ],
      "timeout": 1800000
    },
    "searxng": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/evidence_proxy.py",
        "",
        "--secret",
        "dmai-searxng-path-token",
        "--segment"
      ],
      "timeout": 180000
    },
    "fetch": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/evidence_proxy.py",
        "",
        "--secret",
        "dmai-fetch-path-token",
        "--segment"
      ],
      "timeout": 180000
    },
    "edgar": {
      "command": "python3",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/evidence_proxy.py",
        "",
        "--secret",
        "dmai-edgar-path-token",
        "--segment"
      ],
      "timeout": 180000
    },
    "parallel": {
      "type": "http",
      "url": "https://search.parallel.ai/mcp"
    },
    "alphaxiv": {
      "type": "http",
      "url": "https://api.alphaxiv.org/mcp/v1"
    }
  }
}
