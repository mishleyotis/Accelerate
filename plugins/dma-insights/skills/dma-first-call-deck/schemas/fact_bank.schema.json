{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DMA First Call Fact Bank",
  "description": "Structured facts with mandatory source citations for first call pitch decks.",
  "type": "object",
  "required": ["metadata", "facts"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["client_name", "subvertical", "source_files", "extracted_at"],
      "properties": {
        "client_name": {"type": "string"},
        "subvertical": {"type": "string", "enum": ["cib_banking", "commercial_lending", "credit_unions", "farm_credit", "insurance_brokerages", "insurance_carriers", "retail_banking", "wealth_asset_management", "wealth_rias"]},
        "audience": {"type": "string"},
        "big_idea": {"type": "string"},
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file_id", "filename", "type"],
            "properties": {
              "file_id": {"type": "string"},
              "filename": {"type": "string"},
              "type": {"type": "string", "enum": ["assessment_report", "client_research", "financial_data", "web_search", "connector_data"]}
            }
          }
        },
        "extracted_at": {"type": "string", "format": "date-time"}
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "category", "content", "source"],
        "properties": {
          "fact_id": {"type": "string", "pattern": "^F-\\d{3,4}$"},
          "category": {"type": "string", "enum": ["org_profile", "financial", "strategic_objective", "dma_score", "pillar_score", "capability_score", "peer_comparison", "strength", "opportunity", "solution", "next_step"]},
          "content": {"type": "string"},
          "data_value": {"type": ["number", "null"]},
          "data_unit": {"type": "string"},
          "context": {"type": "string"},
          "source": {
            "type": "object",
            "required": ["file_id", "location"],
            "properties": {
              "file_id": {"type": "string"},
              "location": {"type": "string"},
              "exact_text": {"type": "string"}
            }
          },
          "target_slides": {"type": "array", "items": {"type": "integer"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "evidence_id": {"type": ["string", "null"], "description": "E-xxx ID from DMA assessment if available"}
        }
      }
    },
    "dma_scores": {
      "type": ["object", "null"],
      "properties": {
        "overall": {"type": "number"},
        "peer_median": {"type": "number"},
        "pillars": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "score": {"type": "number"},
              "level": {"type": "integer", "minimum": 1, "maximum": 5},
              "level_label": {"type": "string"}
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "score": {"type": "number"},
              "peer_median": {"type": "number"},
              "heatmap_level": {"type": "string", "enum": ["Activating", "Building", "Competing", "Differentiating"]}
            }
          }
        }
      }
    }
  }
}
