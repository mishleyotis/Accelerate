{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dma-insights/run_manifest_v3",
  "title": "DMA run manifest (run_manifest_v3)",
  "description": "The run's identity anchor, written ONLY by engine.assemble.write_manifest (validated against this file first) and read by the app's package scan, the watchdog, gold_standard, the governance auditor, the contract validator and the calibration engine. Measured 28-09-2026 (QA audit F-N01-019): three incompatible manifest shapes existed — the engine's, a 'run_manifest_v2' the assessment skill's governance exporter invented from CLI flags, and a flat shape the governance auditor demanded that nothing wrote — so IV-02 failed on every real run. One schema, one writer.",
  "type": "object",
  "required": [
    "schema_version", "status", "stage", "run_id", "institution",
    "evidence_mode", "scope_mode", "reference_date", "catalogue_version",
    "catalogue_hash", "workbook_contract", "engine_version", "assembled_at",
    "deliverables", "packets", "gates", "approvals", "decision_log_ref",
    "scores", "evidence_metrics"
  ],
  "properties": {
    "schema_version": {"const": "run_manifest_v3"},
    "status": {"enum": ["IN_PROGRESS", "COMPLETE"]},
    "stage": {"type": "string", "minLength": 1,
              "description": "The boundary this manifest was written at: OPENED, SCORING_PASS, REPORTS_READY, PACKAGE, GOVERNANCE_EXPORT."},
    "opened_at": {"type": ["string", "null"]},
    "checkpointed_at": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[^{}]+$"},
    "institution": {
      "type": "object",
      "required": ["name", "entity_id", "sub_vertical"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^{}]+$"},
        "entity_id": {"type": ["string", "null"]},
        "sub_vertical": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidence_mode": {"type": ["string", "null"]},
    "scope_mode": {"type": ["string", "null"]},
    "reference_date": {"type": ["string", "null"]},
    "catalogue_version": {"type": ["string", "null"]},
    "catalogue_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "workbook_contract": {"type": ["string", "null"]},
    "engine_version": {"type": ["string", "null"]},
    "assembled_at": {"type": "string"},
    "deliverables": {"type": "array", "items": {"type": "string"}},
    "deliverables_expected": {"type": "array", "items": {"type": "string"}},
    "deliverables_present": {"type": "array", "items": {"type": "string"}},
    "packets": {
      "type": "object",
      "description": "Machine packets the run has written, each with the hash of its bytes and its own schema version, so a consumer can tell a stale or edited packet from the one this manifest vouches for.",
      "additionalProperties": {
        "type": "object",
        "required": ["path", "sha256", "schema_version", "verified"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schema_version": {"type": ["string", "null"]},
          "verified": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "object",
      "description": "The last recorded verdict per gate (and scope), from the workbook's Gate_Log.",
      "additionalProperties": {
        "type": "object",
        "required": ["verdict"],
        "properties": {
          "verdict": {"type": "string"},
          "scope": {"type": ["string", "null"]},
          "at": {"type": ["string", "null"]},
          "detail": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "description": "The owner's per-run spend approvals (07_qa/approvals.json), carried so the package states what was authorised.",
      "items": {
        "type": "object",
        "required": ["tool", "cost_line", "approved_by"],
        "properties": {
          "tool": {"type": "string"},
          "cost_line": {"type": "string"},
          "approved_by": {"type": "string"},
          "at": {"type": ["string", "null"]},
          "expires": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "decision_log_ref": {"type": ["string", "null"],
                         "description": "Path of the run registry (dma_run_registry.jsonl) when it exists; null otherwise — never a path that is not there."},
    "scores": {
      "type": ["object", "null"],
      "description": "null until the scoring stage has written its roll-ups (charter invariant 9: computed or null, never a default that looks like data).",
      "required": ["overall", "pillars", "categories"],
      "properties": {
        "overall": {"type": ["number", "null"]},
        "pillars": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
        "categories": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}
      },
      "additionalProperties": false
    },
    "evidence_metrics": {
      "type": "object",
      "required": ["total_items", "tier_distribution"],
      "properties": {
        "total_items": {"type": "integer", "minimum": 0},
        "tier_distribution": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
